{
  "name": "vss",
  "version": "0.2.0-alpha.1",
  "description": "Vetting Support System: offline encrypted tracker for vetting requests and responses",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "out/main/index.js",
  "author": "UNODC-Cyber",
  "homepage": "https://github.com/UNODC-Cyber/VSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UNODC-Cyber/VSS.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node tools/install-electron.mjs",
    "dev": "node tools/install-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node tools/install-electron.mjs && npm run build && vitest run --config vitest.e2e.config.ts",
    "probe:sqlite": "node tools/sqlite-probe.cjs",
    "fixtures:demo": "node tools/fixtures/demo-dataset.ts",
    "fixtures:demo:check": "node tools/fixtures/demo-dataset.ts --check",
    "dist": "node tools/install-electron.mjs && node tools/dist.mjs release",
    "dist:alpha": "node tools/install-electron.mjs && node tools/dist.mjs alpha",
    "verify:channel": "node tools/verify-channel.mjs",
    "verify:fuses": "node tools/verify-fuses.mjs",
    "ui-audit": "npm run build && vitest run --config vitest.ui.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@noble/ciphers": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-table": "9.3.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "i18next": "26.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "ulid": "3.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.11.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "mailparser": "3.14.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
